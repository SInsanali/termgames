#!/bin/bash
# termgames - terminal game collection
# One-command install/run: creates its own venv, installs deps, and offers
# to symlink itself onto your PATH. Re-run any time; it self-heals.

# Resolve symlinks to get the real script directory
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
VENV_DIR="$SCRIPT_DIR/venv"
MARKER_FILE="$SCRIPT_DIR/var/initialized"

mkdir -p "$SCRIPT_DIR/var"

GREEN='\033[1;32m'
CYAN='\033[1;36m'
MAGENTA='\033[1;35m'
RED='\033[1;31m'
DIM='\033[2m'
RESET='\033[0m'

# ── help ──────────────────────────────────────────────────────────────

if [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
    echo "termgames - a small collection of terminal games"
    echo ""
    echo "Usage: ./termgames [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --setup      Run first-time setup (symlink creation) again"
    echo "  -h, --help   Show this help message"
    echo ""
    exit 0
fi

# ── required dependency: python3 ────────────────────────────────────────

if ! command -v python3 &>/dev/null; then
    echo -e "\n${RED}ERROR: python3 is required but was not found${RESET}"
    echo -e "${DIM}  macOS:          brew install python3${RESET}"
    echo -e "${DIM}  Debian/Ubuntu:  sudo apt install python3 python3-venv${RESET}"
    echo -e "${DIM}  Fedora/RHEL:    sudo dnf install python3${RESET}\n"
    exit 1
fi

# ── venv: create or repair ──────────────────────────────────────────────

create_venv() {
    echo -e "${CYAN}>> Creating virtual environment...${RESET}"
    rm -rf "$VENV_DIR"

    if python3 -m venv "$VENV_DIR" 2>/dev/null && [[ -f "$VENV_DIR/bin/python3" ]]; then
        if [[ -f "$VENV_DIR/bin/pip" ]] || "$VENV_DIR/bin/python3" -m pip --version &>/dev/null; then
            return 0
        fi
        echo -e "${CYAN}>> Bootstrapping pip...${RESET}"
        if "$VENV_DIR/bin/python3" -m ensurepip --default-pip &>/dev/null; then
            return 0
        fi
    fi

    rm -rf "$VENV_DIR"
    if python3 -m venv --without-pip "$VENV_DIR" 2>/dev/null && [[ -f "$VENV_DIR/bin/python3" ]]; then
        echo -e "${CYAN}>> Bootstrapping pip...${RESET}"
        if "$VENV_DIR/bin/python3" -m ensurepip --default-pip &>/dev/null; then
            return 0
        fi
        echo -e "${CYAN}>> Downloading pip installer...${RESET}"
        if curl -sS https://bootstrap.pypa.io/get-pip.py -o /tmp/get-pip.py 2>/dev/null || \
           wget -q https://bootstrap.pypa.io/get-pip.py -O /tmp/get-pip.py 2>/dev/null; then
            if "$VENV_DIR/bin/python3" /tmp/get-pip.py &>/dev/null; then
                rm -f /tmp/get-pip.py
                return 0
            fi
            rm -f /tmp/get-pip.py
        fi
    fi

    rm -rf "$VENV_DIR"
    return 1
}

if [[ ! -f "$VENV_DIR/bin/python3" ]] || ! "$VENV_DIR/bin/python3" -c "import termgames, textual" 2>/dev/null; then
    if [[ -f "$VENV_DIR/bin/python3" ]] && "$VENV_DIR/bin/python3" -m pip --version &>/dev/null; then
        echo -e "${CYAN}>> Reinstalling dependencies...${RESET}"
    else
        if ! create_venv; then
            echo -e "${RED}>> Failed to create virtual environment${RESET}"
            echo -e "${DIM}   On Debian/Ubuntu, install: sudo apt install python3-venv${RESET}"
            echo -e "${DIM}   On macOS, try: xcode-select --install${RESET}"
            exit 1
        fi
    fi
    echo -e "${CYAN}>> Installing dependencies...${RESET}"
    if ! "$VENV_DIR/bin/python3" -m pip install -q -e "$SCRIPT_DIR"; then
        echo -e "${RED}>> Failed to install dependencies${RESET}"
        rm -rf "$VENV_DIR"
        exit 1
    fi
fi

# ── first-time setup: offer a PATH symlink ──────────────────────────────

in_path() {
    [[ ":$PATH:" == *":$1:"* ]]
}

create_symlink() {
    local target_dir="$1" link_name="$2"
    local link_path="$target_dir/$link_name"

    if [[ -e "$link_path" ]] || [[ -L "$link_path" ]]; then
        echo -e "${MAGENTA}>> $link_path already exists${RESET}"
        read -p "   Overwrite? [y/N]: " overwrite
        [[ "$overwrite" != "y" && "$overwrite" != "Y" ]] && return 1
        rm -f "$link_path"
    fi

    if ln -s "$SCRIPT_DIR/termgames" "$link_path" && [[ -L "$link_path" ]]; then
        echo -e "${GREEN}>> Symlink created: ${CYAN}$link_path${RESET}"
        echo -e "${DIM}>> You can now run '${link_name}' from anywhere${RESET}\n"
        return 0
    fi

    echo -e "${MAGENTA}>> Failed to create symlink${RESET}"
    return 1
}

first_time_setup() {
    echo ""
    echo -e "${GREEN}▛▀▘ ▞▀▖ ▙▄▖▛▚▖▛▀▘ ▝▀▖▝▀▖▛▚▖▞▀▖▞▀▘${RESET}"
    echo -e "${GREEN}  ▌ ▛▀  ▌ ▌▌▝▌▌▄▖ ▞▀▌▞▀▌▌▝▌▛▀ ▝▀▖${RESET}"
    echo -e "${GREEN}  ▘ ▀▀▘ ▘ ▘▘ ▘▀▀▘ ▝▀▘▝▀▘▘ ▘▝▀▘▀▀ ${RESET}"
    echo -e "${DIM}────────────────────────────────${RESET}"
    echo ""
    echo -e "${CYAN}>> First time setup${RESET}"
    echo ""

    local bin_dirs=("$HOME/.local/bin" "$HOME/bin" "/usr/local/bin")
    local available_dirs=()
    for dir in "${bin_dirs[@]}"; do
        in_path "$dir" || continue
        if [[ -d "$dir" ]]; then
            available_dirs+=("$dir")
        else
            available_dirs+=("$dir (will create)")
        fi
    done

    if [[ ${#available_dirs[@]} -eq 0 ]]; then
        echo -e "${MAGENTA}>> No standard bin directories found in PATH${RESET}"
        echo -e "   Add ~/.local/bin to your PATH and re-run with --setup"
        echo ""
        touch "$MARKER_FILE"
        return
    fi

    echo -e "   Create a symlink to run termgames from anywhere?"
    echo ""
    local i=1
    for dir in "${available_dirs[@]}"; do
        echo -e "   ${GREEN}[$i]${RESET} $dir"
        ((i++))
    done
    echo -e "   ${DIM}[s] Skip${RESET}"
    echo ""
    read -p "   >> Select directory: " choice

    if [[ "$choice" == "s" ]] || [[ "$choice" == "S" ]]; then
        echo -e "\n${DIM}>> Skipped. Run with --setup to configure later.${RESET}\n"
        touch "$MARKER_FILE"
        return
    fi

    if [[ "$choice" =~ ^[0-9]+$ ]] && [[ "$choice" -ge 1 ]] && [[ "$choice" -le ${#available_dirs[@]} ]]; then
        local selected="${available_dirs[$((choice-1))]}"
        selected="${selected% (will create)}"

        if [[ ! -d "$selected" ]]; then
            mkdir -p "$selected"
            echo -e "\n${GREEN}>> Created $selected${RESET}"
        fi
        echo ""

        for cmd_name in "termgames" "tg"; do
            echo -e "   Trying command name: ${CYAN}${cmd_name}${RESET}"
            if create_symlink "$selected" "$cmd_name"; then
                touch "$MARKER_FILE"
                return
            fi
        done

        echo ""
        read -p "   >> Enter custom command name (or 's' to skip): " custom_name
        if [[ -n "$custom_name" ]] && [[ "$custom_name" != "s" ]]; then
            create_symlink "$selected" "$custom_name"
        fi
    else
        echo -e "\n${DIM}>> Invalid selection, skipped.${RESET}\n"
    fi

    touch "$MARKER_FILE"
}

if [[ ! -f "$MARKER_FILE" ]] || [[ "$1" == "--setup" ]]; then
    first_time_setup
    [[ "$1" == "--setup" ]] && shift
fi

# ── launch ───────────────────────────────────────────────────────────────

exec "$VENV_DIR/bin/python3" -m termgames "$@"
